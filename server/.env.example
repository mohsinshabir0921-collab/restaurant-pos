# Server configuration example. Copy to .env and fill in real values.
# NEVER commit the real .env file.

PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://user:password@host:port/dbname

# JWT secret used to sign access and refresh tokens
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay API keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay webhook secret used to verify X-Razorpay-Signature on webhooks.
# Set to the value shown in the Razorpay Dashboard (Webhooks -> your endpoint).
RAZORPAY_WEBHOOK_SECRET=

# Allowed frontend origin(s) for CORS (comma-separated if multiple).
# Defaults to the Vite dev server (http://localhost:5173) when not set.
CLIENT_URL=http://localhost:5173

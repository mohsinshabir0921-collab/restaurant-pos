# Server configuration example. Copy to .env and fill in real values.
# NEVER commit the real .env file.

PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://user:password@host:port/dbname

# JWT secret used to sign access and refresh tokens
JWT_SECRET=change-me-to-a-long-random-string

# Cashfree Payment Gateway
# Environment: "sandbox" for testing, "production" for live payments.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret

# Cashfree webhook secret used to verify X-Webhook-Signature on webhooks.
# Set to the value shown in the Cashfree Dashboard (Webhooks -> your endpoint).
CASHFREE_WEBHOOK_SECRET=

# Optional: per-order webhook notify_url. Leave empty to rely on the webhook
# endpoint configured in the Cashfree Dashboard.
CASHFREE_WEBHOOK_URL=

# Optional: Cashfree PG API version (defaults to 2023-08-01).
# CASHFREE_API_VERSION=2023-08-01

# Allowed frontend origin(s) for CORS (comma-separated if multiple).
# Defaults to the Vite dev server (http://localhost:5173) when not set.
CLIENT_URL=http://localhost:5173

# Public website origin used to build shareable customer links
# (e.g. additional-payment links at /pay/<token>). Must be the real public
# site (https://khyennchyenn.co.in in production) - never localhost or LAN IPs.
# When unset, payment links fall back to CLIENT_URL, which is only correct for
# local dev.
WEBSITE_URL=https://khyennchyenn.co.in

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# https://github.com/web-push-libs/web-push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@restaurant.com

# TEMPORARY: Bypass opening-hours closed guard for online orders (easy to remove later).
# When BYPASS_ORDERING_HOURS=true, isRestaurantOpenNow() returns true and publicRoutes
# skip the 403 closed check. Default is false (normal hours enforcement).
# BYPASS_ORDERING_HOURS=true
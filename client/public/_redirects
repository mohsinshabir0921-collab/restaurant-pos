# Public website (BrowserRouter basename=/website) SPA fallback.
# Static files take precedence, so /website.html still serves directly and
# Cloudflare pretty-urls continue to redirect /website.html -> /website.
/website      /website.html  200
/website/*    /website.html  200

# Convenience SEO redirects to the public website. These paths are NOT used
# by the POS admin app, so they are safe to redirect.
/cart*        /website/cart:splat        301
/checkout*    /website/checkout:splat    301
/track*       /website/track:splat       301

# POS SPA fallback (must stay last). Every non-asset path is rewritten to
# /index.html so POS (BrowserRouter) routes like /login and /dashboard keep
# working on refresh. NOTE: /menu is owned by the POS admin app and is left
# here intentionally (not redirected) to avoid breaking the POS application.
/*  /index.html  200

# Public website API base URL (required for production).
# Set the same value as a Netlify environment variable named VITE_API_URL.
# Local dev: leave unset to use the Vite proxy (/api -> http://localhost:5000),
# or point it at your local backend (http://localhost:5000/api).
VITE_API_URL=https://your-api.example.com/api

# Web Push VAPID public key (for POS push notifications)
VITE_VAPID_PUBLIC_KEY=

# TEMPORARY: Bypass opening-hours closed guard on the website (easy to remove later).
# When VITE_BYPASS_ORDERING_HOURS=true, WebsiteContext forces isOpen=true.
# VITE_BYPASS_ORDERING_HOURS=true

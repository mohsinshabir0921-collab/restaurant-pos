# Dependencies
node_modules/

# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Environment files (defense in depth for this repo layout)
server/.env
client/.env

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Misc
*.local
.cache/
coverage/

# Local opencode tool backups (may contain API keys / provider credentials)
opencode.json.backup
opencode.json.before-omniroute-fix

# Server seed/test artifacts (hardcoded credentials / manual test payloads)
server/seedAdmin.js
server/order-test.json

# Runtime uploaded hero media (server-backed storage) — never commit uploads
server/.uploads-mock/
